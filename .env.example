# --- Database (Neon) ---
# Pooled connection string from Neon. Used at runtime by Prisma Client.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct/unpooled connection string. Used by Prisma Migrate only.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Auth.js v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Anthropic (placeholder only; not consumed until Phase 8) ---
ANTHROPIC_API_KEY=""
# --- Coach provider selection (ARCH-045) ---
MODEL_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
