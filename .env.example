# --- Database (Neon) ---
# Pooled connection string from Neon. Used at runtime by Prisma Client.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct/unpooled connection string. Used by Prisma Migrate and, on Vercel,
# exposed to the runtime as DATABASE_URL_UNPOOLED for admin scripts.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# --- Auth.js v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Coach model provider (ARCH-045) ---
# MODEL_PROVIDER selects the concrete provider:
#   anthropic  (default; requires a billed ANTHROPIC_API_KEY)
#   gemini     (free tier available; requires GEMINI_API_KEY)
#   mock       (no network; used in CI and for local exploration)
MODEL_PROVIDER="anthropic"

# Anthropic (default provider)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# Google Gemini (second provider)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# --- Rate limiting (Upstash Redis — ARCH-048) ---
# https://console.upstash.com/ → create database → REST API section.
# The middleware reads these directly (not via @training/config) because
# it runs in the Edge runtime. If unset, rate limiting fails open.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Launch gate (ARCH-046) ---
# Set ONLY in Vercel's Production environment. Never in Preview or
# Development; never committed. Generate with: openssl rand -base64 32.
# See docs/LAUNCH_CHECKLIST.md §6 for the rotation procedure.
LAUNCH_OVERRIDE_TOKEN=""